{
  "name": "vue-dlg",
  "version": "3.0.0-beta.0",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Vue Dialog",
  "author": "Andrey Tyurin <ectb@mail.ru>",
  "repository": "git@github.com:oploshka/vue-dialog.git",
  "homepage": "https://oploshka.github.io/vue-dialog/",
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "serve": "vite --config vite.demo.config.ts",
    "build": "vite build --config vite.demo.config.ts",
    "build:ph-pages": "vite build --config vite.demo.config.ts --mode ph-pages",
    "build:library": "vite build --config vite.lib.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/*"
  ],
  "keywords": [
    "vue",
    "vuejs",
    "vue-dialog",
    "vue-dlg",
    "dialog",
    "dialogs",
    "slim",
    "alert",
    "confirm",
    "prompt",
    "v-dlg",
    "v-dialog",
    "v-dialogs"
  ],
  "dependencies": {
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.12.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "sass-embedded": "1.102.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-inspect": "12.0.2",
    "vue-tsc": "3.3.10"
  }
}
