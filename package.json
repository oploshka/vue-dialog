{
  "name": "vue-dlg",
  "version": "3.0.0-beta.0",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Vue Dialog",
  "author": "Andrey Tyurin <ectb@mail.ru>",
  "repository": "git@github.com:oploshka/vue-dialog.git",
  "homepage": "https://oploshka.github.io/vue-dialog/",
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "serve": "vite --config vite.demo.config.ts",
    "build": "vite build --config vite.demo.config.ts",
    "build:ph-pages": "vite build --config vite.demo.config.ts --mode ph-pages",
    "build:library": "vite build --config vite.lib.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "vue",
    "vuejs",
    "vue-dialog",
    "vue-dlg",
    "dialog",
    "dialogs",
    "slim",
    "alert",
    "confirm",
    "prompt",
    "v-dlg",
    "v-dialog",
    "v-dialogs"
  ],
  "dependencies": {
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.12",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.12.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/language-core": "3.3.10",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.11.2",
    "sass-embedded": "1.102.0",
    "typescript": "6.0.3",
    "unplugin-dts": "1.0.3",
    "vite": "8.2.1",
    "vite-plugin-inspect": "12.0.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.10"
  }
}
